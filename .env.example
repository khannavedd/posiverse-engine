# Same Cloud SQL database posiverseApi uses — this service reads/writes
# InStock, OutboxEvent, and ProcessedOutboxEvent in that same database,
# there's no separate inventory-engine database.

# Local dev (public IP + SSL) or via Cloud SQL Auth Proxy (127.0.0.1, no SSL):
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=5432

# Cloud Run only — leave unset locally. When set, connects over the
# mounted Unix socket instead of DB_HOST.
INSTANCE_CONNECTION_NAME=

# Shared secret checked against the Pub/Sub push subscription's
# ?token= query param. Leave unset locally to skip the check.
INVENTORY_PUSH_SECRET=

# Same idea, but for Sale's own push endpoint/subscription (kept
# separate from INVENTORY_PUSH_SECRET so each can be rotated
# independently) — see routes/Sales/sales.js.
SALES_PUSH_SECRET=

PORT=8081
